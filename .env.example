# Keep this file safe to commit. Add values only to .env.local (ignored by Git).
OPENAI_API_KEY=
# This server-only key is used by the OpenAI Agents SDK. Never prefix it with NEXT_PUBLIC_.
OPENAI_MODEL=gpt-4.1-mini
# Server-only speech-to-text model used only after a user records audio.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Care updates can contain health information, so SDK tracing stays off by default.
OPENAI_AGENTS_DISABLE_TRACING=1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only credential used exclusively by the Express backend to make
# trusted writes after it has checked the signed-in user's permissions.
# Never prefix this value with NEXT_PUBLIC_ and never place it in frontend/.env.local.
SUPABASE_SERVICE_ROLE_KEY=
# Backend accepts requests from this local frontend origin.
FRONTEND_ORIGIN=http://localhost:3000
# The frontend sends updates only to this separate backend service.
NEXT_PUBLIC_API_URL=http://localhost:4000
